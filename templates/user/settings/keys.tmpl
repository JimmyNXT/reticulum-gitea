{{template "user/settings/layout_head" (dict "pageClass" "user settings sshkeys")}}
	<div class="user-setting-content">
		{{if not ($.UserDisabledFeatures.Contains "manage_ssh_keys")}}
			{{template "user/settings/keys_ssh" .}}
		{{end}}
		{{template "user/settings/keys_principal" .}}
		{{if not ($.UserDisabledFeatures.Contains "manage_gpg_keys")}}
			{{template "user/settings/keys_gpg" .}}
		{{end}}
		{{if not ($.UserDisabledFeatures.Contains "manage_rns_identities")}}
			{{template "user/settings/keys_rns_identity" .}}
		{{end}}
	</div>
{{template "user/settings/layout_footer" .}}
