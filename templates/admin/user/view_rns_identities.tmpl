<div class="flex-divided-list items-with-main">
	{{range .RNSIdentities}}
		<div class="item">
			<div class="item-main">
				<div class="item-title">
					<b>{{.Name}}</b>
				</div>
				<div class="item-body">
					<span class="tw-font-mono">{{.IdentityHash}}</span>
				</div>
				<div class="item-body">
					<i>{{ctx.Locale.Tr "settings.added_on" (DateUtils.AbsoluteShort .CreatedUnix)}}</i>
				</div>
			</div>
		</div>
	{{end}}
</div>
